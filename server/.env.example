PORT=4000
# Laptop par MongoDB chal raha hai to (MONGODB_URI na do to bhi yahi default use hota hai):
MONGODB_URI=mongodb://127.0.0.1:27017/bolkhata
# Atlas use karna ho to upar wali line hatakar ye daalo:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bolkhata?retryWrites=true&w=majority

# Atlas par "querySrv ECONNREFUSED" aaye to ye kholo:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Login token ko sign karne ki secret key (kam se kam 32 akshar, random).
# Banane ke liye:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Development me khali chhodo to server khud bana leta hai. Production me zaroor do.
JWT_SECRET=

# Sirf testing ke liye: "true" karoge to OTP app me bhi dikhega (SMS ke bina test kar sakte ho).
# Production me ise kabhi true mat rakhna.
DEV_SHOW_OTP=true

# Render / Railway jaise host ke peeche chalaoge to 1 rakho (sahi client IP ke liye)
# TRUST_PROXY=1
